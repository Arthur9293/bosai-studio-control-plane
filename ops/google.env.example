# Vertex AI / Google ADK runtime. No secret is committed here.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=YOUR_GOOGLE_CLOUD_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
BOSAI_GEMINI_MODEL=gemini-2.5-flash

# Existing Grafana runtime boundary from Phase 4.
GRAFANA_URL=https://YOUR_STACK.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=REDACTED
BOSAI_GRAFANA_LOKI_DATASOURCE_UID=grafanacloud-logs
