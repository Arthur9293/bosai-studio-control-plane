# Grafana instance read access for official mcp-grafana.
GRAFANA_URL=https://YOUR_STACK.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=REDACTED

# Grafana Cloud generates the OTLP variables below from the OpenTelemetry tile.
# For Python, Grafana documents encoding the space in "Basic " as "Basic%20".
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://YOUR_OTLP_GATEWAY.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20REDACTED
